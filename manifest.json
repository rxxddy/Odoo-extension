{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "3.0.0",
  "description": "__MSG_appDesc__",
  "author": "Weden <wedendev@gmail.com>",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "host_permissions": [
    "*://*.odoo.com/*",
    "*://*.odoo.sh/*"
  ],
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.odoo.com/*",
        "*://*.odoo.sh/*"
      ],
      "js": [
        "src/shared/defaults.js",
        "src/shared/themes.js",
        "src/content/namespace.js",
        "src/content/state.js",
        "src/content/wallpaper.js",
        "src/content/styles.js",
        "src/content/media-layers.js",
        "src/content/banners.js",
        "src/content/environment.js",
        "src/content/debug-mode.js",
        "src/content/field-names.js",
        "src/content/editor.js",
        "src/content/messages.js",
        "src/content/index.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page/editor-bridge.js"
      ],
      "matches": [
        "*://*.odoo.com/*",
        "*://*.odoo.sh/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  }
}
